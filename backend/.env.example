DATABASE_URL="sqlserver://localhost:14330;database=elder_web;user=sa;password=SUA_SENHA_REAL_AQUI;encrypt=true;trustServerCertificate=true"
PORT=3000
FRONTEND_URL=http://localhost:5173
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Produção (Azure SQL): sqlserver://<servidor>.database.windows.net:1433;database=elder_web;user=<usuario>;password=<senha>;encrypt=true;trustServerCertificate=false
# Aviso de emergência (POST /emergencia/avisar): e-mail transacional por API HTTPS (o Render free bloqueia SMTP).
# Sem EMAIL_API_KEY ou EMAIL_REMETENTE_ENDERECO só o aviso falha (503); o resto do app funciona.
# EMAIL_REMETENTE_ENDERECO precisa ser um remetente cadastrado e verificado na Brevo (Settings, Senders, Domains, IPs).
# Gmail verificado como remetente funciona e chega na caixa de entrada, mas a Brevo troca o domínio por @<id>.brevosend.com
# (Gmail não pode ser autenticado). Entrega confiável em escala pede domínio próprio com SPF/DKIM/DMARC.
# Chave nova: Settings, SMTP & API, API Keys.
# IPs autorizados: com "Block unknown IP addresses" ligado (Settings, Security, Authorized IPs) a API responde HTTP 401
# "unrecognised IP address". O Render free não tem IP fixo: use "Deactivate blocking" (risco aceito).
# Teste: npx tsx scripts/testar-email.ts <endereço> (dentro de backend/; só envia para o e-mail do Marcos).
EMAIL_API_KEY=
EMAIL_REMETENTE_NOME=
EMAIL_REMETENTE_ENDERECO=
